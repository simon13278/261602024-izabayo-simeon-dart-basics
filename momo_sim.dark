// Reg no: 26160
const String regNo = '26160';
final int d = int.parse(regNo[regNo.length - 1]);
final int t = int.parse(regNo.substring(regNo.length - 2));

// Copied from D2
int momoFee(int amount) {
  // by IS
  if (amount <= 0) return -1;
  if (amount <= 1000) return 20;
  if (amount <= 10000) return 100;
  if (amount <= 150000) return 250;
  return 1500;
}

// 1. formatRwf
String formatRwf(int amount) {
  // by IS
  bool negative = amount < 0;
  String digits = (negative ? -amount : amount).toString();
  String result = '';
  int count = 0;
  int i = digits.length - 1;
  while (i >= 0) {
    if (count > 0 && count % 3 == 0) {
      result = ',$result';
    }
    result = digits[i] + result;
    count++;
    i--;
  }
  return '${negative ? '-' : ''}$result RWF';
}

// 2. isValidPin
bool isValidPin(String pin) {
  // by IS
  if (pin.length != 5) return false;
  int i = 0;
  while (i < pin.length) {
    int code = pin.codeUnitAt(i);
    if (code < 48 || code > 57) return false; // not a digit 0-9
    i++;
  }
  if (pin == '12345') return false;
  bool allSame = true;
  int j = 1;
  while (j < pin.length) {
    if (pin[j] != pin[0]) {
      allSame = false;
    }
    j++;
  }
  if (allSame) return false;
  return true;
}

// 3. sendMoney
int sendMoney(int balance, int amount) {
  // by IS
  int fee = momoFee(amount);
  if (fee == -1) {
    print('Failed: invalid amount');
    return balance;
  }
  if (amount + fee > balance) {
    print('Failed: insufficient balance');
    return balance;
  }
  int newBalance = balance - amount - fee;
  print('Sent ${formatRwf(amount)} (fee ${formatRwf(fee)}). '
      'New balance: ${formatRwf(newBalance)}');
  return newBalance;
}

// 4. buyAirtime
int buyAirtime(int balance, int amount) {
  // by IS
  if (amount < 100 || amount > 50000) {
    print('Failed: airtime amount must be from 100 to 50,000 RWF');
    return balance;
  }
  if (amount > balance) {
    print('Failed: insufficient balance');
    return balance;
  }
  int newBalance = balance - amount;
  print('Airtime bought: ${formatRwf(amount)}. '
      'New balance: ${formatRwf(newBalance)}');
  return newBalance;
}

void main() {
  // by IS
  print('Reg no: $regNo | D = $d | T = $t');

  // 1. PIN checks
  print("isValidPin('12345') = ${isValidPin('12345')}");
  print("isValidPin('77777') = ${isValidPin('77777')}");
  print("isValidPin('4821') = ${isValidPin('4821')}");
  print("isValidPin('48a21') = ${isValidPin('48a21')}");
  print("isValidPin('4821$d') = ${isValidPin('4821$d')}");

  // 2. Starting balance
  int balance = 20000 + t * 500;
  print('Starting balance: ${formatRwf(balance)}');

  // 3. Transactions
  balance = sendMoney(balance, (d + 1) * 3000);
  balance = sendMoney(balance, (d + 1) * 3000);
  balance = sendMoney(balance, (d + 1) * 3000);
  balance = buyAirtime(balance, 1000);
  balance = sendMoney(balance, 0);
  balance = sendMoney(balance, 200000);

  // 4. Final balance
  print('Final balance: ${formatRwf(balance)}');

  // 5. My own tests (expected output in comments)
  print(formatRwf(100));        // 100 RWF
  print(formatRwf(100000));     // 100,000 RWF
  print(formatRwf(-1000));      // -1,000 RWF
  print(formatRwf(1000000));    // 1,000,000 RWF
  print(isValidPin(''));        // false
  print(isValidPin('00000'));   // false
  print(isValidPin('54321'));   // true
  print(isValidPin('1234 '));   // false (a space is not a digit)
  print(isValidPin('١٢٣٤٥'));   // false (Arabic-Indic digits are 5 chars but not 0-9) <- might break code
}
